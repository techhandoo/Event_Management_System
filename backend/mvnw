#!/bin/sh
# ═══════════════════════════════════════════════════════════════
# Maven Wrapper — detects local Maven or falls back to PATH mvn
# ═══════════════════════════════════════════════════════════════
set -e

# ─── Check if mvn is already on PATH ─────────────────────
if command -v mvn > /dev/null 2>&1; then
    exec mvn "$@"
fi

# ─── Search for Maven in ~/.m2/wrapper/dists ─────────────
for DIST_DIR in "${HOME}/.m2/wrapper/dists/apache-maven-"*; do
    if [ -d "$DIST_DIR" ]; then
        for SUB_DIR in "$DIST_DIR"/*/; do
            if [ -f "${SUB_DIR}bin/mvn" ]; then
                exec "${SUB_DIR}bin/mvn" "$@"
            fi
        done
    fi
done

# ─── Fallback message ────────────────────────────────────
echo "ERROR: mvn not found on PATH and no local Maven installation detected." >&2
echo "Install Maven: https://maven.apache.org/install.html" >&2
echo "Or use: sdk install maven" >&2
exit 1
