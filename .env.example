# ═══════════════════════════════════════════════════════════════
# Eventry — Environment Variables
# Copy this file to .env and fill in values
# ═══════════════════════════════════════════════════════════════

# ─── JWT (Required) ──────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=

# ─── Database (Required for prod) ────────────────────────
# For local dev, defaults work with docker-compose
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ─── Email (Optional) ────────────────────────────────────
# Get API key from resend.com
RESEND_API_KEY=

# ─── Admin Seed (Optional) ───────────────────────────────
# Set to enable the POST /api/auth/seed-admin endpoint
ADMIN_SEED_KEY=

# ─── Frontend URL ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
